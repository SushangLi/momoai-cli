{
  "id": "openclaw-a2a-skill-router",
  "name": "OpenClaw A2A Skill Router",
  "description": "Maps A2A capability ids to local OpenClaw skill instructions without changing the standard A2A communication plugin.",
  "activation": {
    "onStartup": true,
    "onConfigPaths": [
      "plugins.entries.openclaw-a2a-skill-router"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "services": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/$defs/service"
        }
      }
    },
    "$defs": {
      "skill": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "instructions": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "instructions"
        ]
      },
      "skillBinding": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "capabilityId": {
            "type": "string",
            "minLength": 1
          },
          "capabilityName": {
            "type": "string"
          },
          "capabilityDescription": {
            "type": "string"
          },
          "inputModes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputModes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "skill": {
            "$ref": "#/$defs/skill"
          }
        },
        "required": [
          "capabilityId",
          "skill"
        ]
      },
      "service": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "openclawAgent": {
            "type": "string"
          },
          "timeoutSeconds": {
            "type": "number",
            "minimum": 1
          },
          "skillBindings": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/skillBinding"
            }
          }
        }
      }
    }
  }
}
