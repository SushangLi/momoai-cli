{
  "name": "momoai-cli",
  "version": "0.1.0",
  "description": "Marketplace-native agent CLI for MOMOAI trading, A2A invocation, and remote provider publishing",
  "license": "MIT",
  "author": "MOMOAI CLI contributors",
  "homepage": "https://www.momoai.pro/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SushangLi/momoai-cli.git"
  },
  "bugs": {
    "url": "https://github.com/SushangLi/momoai-cli/issues"
  },
  "keywords": [
    "momoai",
    "agent",
    "a2a",
    "marketplace",
    "cli",
    "openclaw"
  ],
  "type": "module",
  "bin": {
    "momoai": "./dist/index.js"
  },
  "exports": {
    "./provider-sdk": {
      "types": "./dist/provider-sdk.d.ts",
      "import": "./dist/provider-sdk.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "demo": "node demo/run-momoai-flow.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "smoke": "npm run build && node dist/index.js help && node dist/index.js agent card --json && node dist/index.js agent market-card --json",
    "test": "npm run build && node --test tests/*.test.mjs && tsx --test test/*.test.ts",
    "test:provider-sdk": "npm run build && node -e \"import('./dist/provider-sdk.js')\""
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.22.3",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.13",
    "express": "^5.2.1",
    "jose": "^6.2.3",
    "ws": "^8.21.0"
  }
}
